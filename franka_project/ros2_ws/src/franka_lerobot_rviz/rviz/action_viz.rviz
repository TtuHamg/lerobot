Panels:
  - Class: rviz_common/Displays
    Help Height: 78
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /Robot1
        - /LeRobot candidate1
        - /Gateway active1
        - /Actual TCP trail1
        - /Plan state markers1
        - /Observation camera1 (base_0_rgb)1
        - /Observation camera2 (left_wrist_0_rgb)1
      Splitter Ratio: 0.5
    Tree Height: 720
  - Class: rviz_common/Selection
    Name: Selection
  - Class: rviz_common/Views
    Expanded:
      - /Current View1
    Name: Views
    Splitter Ratio: 0.5
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.45
      Cell Size: 0.1
      Class: rviz_default_plugins/Grid
      Color: 120; 120; 120
      Enabled: true
      Line Style:
        Line Width: 0.01
        Value: Lines
      Name: Base plane
      Normal Cell Count: 0
      Offset:
        X: 0
        Y: 0
        Z: 0
      Plane: XY
      Plane Cell Count: 20
      Reference Frame: <Fixed Frame>
      Value: true
    - Alpha: 0.72
      Class: rviz_default_plugins/RobotModel
      Collision Enabled: false
      Description File: ""
      Description Source: Topic
      Description Topic:
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /robot_description
      Enabled: true
      Links:
        All Links Enabled: true
        Expand Joint Details: false
        Expand Link Details: false
        Expand Tree: false
        Link Tree Style: Links in Alphabetic Order
      Name: Robot
      TF Prefix: ""
      Update Interval: 0
      Value: true
      Visual Enabled: true
    - Alpha: 0.50
      Buffer Length: 1
      Class: rviz_default_plugins/Path
      Color: 0; 190; 255
      Enabled: true
      Head Diameter: 0.03
      Head Length: 0.02
      Length: 0.3
      Line Style: Lines
      Line Width: 0.004
      Name: LeRobot candidate
      Offset:
        X: 0
        Y: 0
        Z: 0
      Pose Color: 0; 190; 255
      Pose Style: None
      Radius: 0.03
      Shaft Diameter: 0.01
      Shaft Length: 0.1
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /lerobot/franka/viz/planned_path
      Value: true
    - Alpha: 0.90
      Buffer Length: 1
      Class: rviz_default_plugins/Path
      Color: 25; 240; 55
      Enabled: true
      Head Diameter: 0.03
      Head Length: 0.02
      Length: 0.3
      Line Style: Lines
      Line Width: 0.009
      Name: Gateway active
      Offset:
        X: 0
        Y: 0
        Z: 0
      Pose Color: 25; 240; 55
      Pose Style: None
      Radius: 0.03
      Shaft Diameter: 0.01
      Shaft Length: 0.1
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /lerobot/franka/viz/active_path
      Value: true
    - Alpha: 0.90
      Buffer Length: 1
      Class: rviz_default_plugins/Path
      Color: 255; 255; 255
      Enabled: true
      Head Diameter: 0.03
      Head Length: 0.02
      Length: 0.3
      Line Style: Lines
      Line Width: 0.006
      Name: Actual TCP trail
      Offset:
        X: 0
        Y: 0
        Z: 0
      Pose Color: 255; 255; 255
      Pose Style: None
      Radius: 0.03
      Shaft Diameter: 0.01
      Shaft Length: 0.1
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /lerobot/franka/viz/actual_path
      Value: true
    - Alpha: 1
      Axes Length: 0.10
      Axes Radius: 0.010
      Class: rviz_default_plugins/Pose
      Color: 255; 255; 255
      Enabled: true
      Head Length: 0.045
      Head Radius: 0.020
      Name: Actual TCP pose
      Shaft Length: 0.10
      Shaft Radius: 0.010
      Shape: Axes
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /lerobot/franka/viz/actual_pose
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Plan state markers
      Namespaces: {}
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /lerobot/franka/viz/markers
      Value: true
    - Class: rviz_default_plugins/Image
      Enabled: true
      Max Value: 1
      Median window: 5
      Min Value: 0
      Name: Observation camera1 (base_0_rgb)
      Normalize Range: false
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /camera1/camera1/color/image_raw
      Value: true
    - Class: rviz_default_plugins/Image
      Enabled: true
      Max Value: 1
      Median window: 5
      Min Value: 0
      Name: Observation camera2 (left_wrist_0_rgb)
      Normalize Range: false
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /camera2/camera2/color/image_raw
      Value: true
    - Alpha: 0.40
      Axes Length: 0.05
      Axes Radius: 0.005
      Class: rviz_default_plugins/PoseArray
      Color: 0; 190; 255
      Enabled: false
      Head Length: 0.02
      Head Radius: 0.01
      Name: All candidate poses (optional)
      Shaft Length: 0.05
      Shaft Radius: 0.005
      Shape: Axes
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /lerobot/franka/viz/planned_poses
      Value: false
    - Class: rviz_default_plugins/TF
      Enabled: false
      Frame Timeout: 15
      Frames:
        All Enabled: true
      Marker Scale: 0.12
      Name: TF frames (optional)
      Show Arrows: true
      Show Axes: true
      Show Names: true
      Tree: {}
      Update Interval: 0
      Value: false
  Enabled: true
  Global Options:
    Background Color: 35; 35; 35
    Fixed Frame: base
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
      Hide Inactive Objects: true
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
      Line color: 128; 128; 0
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 1.9
      Enable Stereo Rendering:
        Stereo Eye Separation: 0.06
        Stereo Focal Distance: 1
        Swap Stereo Eyes: false
        Value: false
      Focal Point:
        X: 0.35
        Y: 0
        Z: 0.35
      Focal Shape Fixed Size: true
      Focal Shape Size: 0.05
      Invert Z Axis: false
      Name: Current View
      Near Clip Distance: 0.01
      Pitch: 0.38
      Target Frame: base
      Value: Orbit (rviz)
      Yaw: 2.35
    Saved: ~
Window Geometry:
  Observation camera1 (base_0_rgb):
    collapsed: false
  Observation camera2 (left_wrist_0_rgb):
    collapsed: false
  Displays:
    collapsed: false
  Height: 900
  Hide Left Dock: false
  Hide Right Dock: true
  Selection:
    collapsed: false
  Views:
    collapsed: false
  Width: 1500
  X: 60
  Y: 40
