+// limitations under the License.
+
+#include <gtest/gtest.h>
+
+#include <franka_arm_controllers/safety_position_hold.hpp>
+
+namespace {
+
+using franka_arm_controllers::safety_command::JointArray;
+using franka_arm_controllers::safety_command::PositionHold;
+
+const JointArray kInitial{0.1, -0.1, 0.2, -1.6, 0.0, 1.6, -0.1};
+const JointArray kMoved{0.2, -0.2, 0.3, -1.5, 0.1, 1.5, 0.0};
+const JointArray kTarget{0.3, -0.3, 0.4, -1.4, 0.2, 1.4, 0.1};
+
+TEST(SafetyPositionHold, StartupResistsDisplacementWhileWaitingForFirstCommand) {
+  PositionHold hold;
+  EXPECT_EQ(hold.resolve(false, {}, kInitial), kInitial);
+  for (int cycle = 0; cycle < 1000; ++cycle) {
+    const auto target = hold.resolve(false, {}, kMoved);
+    EXPECT_EQ(target, kInitial);
+    // With nonzero stiffness this error produces a restoring torque. Updating
+    // the target to kMoved each cycle would zero it and reproduce the bug.
+    EXPECT_LT(target[0] - kMoved[0], 0.0);
+    EXPECT_GT(target[1] - kMoved[1], 0.0);
+  }
+}
+
+TEST(SafetyPositionHold, DisarmOrTimeoutHoldsMeasuredPoseInsteadOfChasingOldCommand) {
+  PositionHold hold;
+  EXPECT_EQ(hold.resolve(true, kTarget, kInitial), kTarget);
+  EXPECT_EQ(hold.resolve(false, kTarget, kMoved), kMoved);
+  EXPECT_EQ(hold.resolve(false, kTarget, kInitial), kMoved);
+}
+
+TEST(SafetyPositionHold, FreshInputReleasesHoldAndNextStopCapturesNewPose) {
+  PositionHold hold;
+  EXPECT_EQ(hold.resolve(false, {}, kInitial), kInitial);
+  EXPECT_EQ(hold.resolve(true, kTarget, kMoved), kTarget);
+  EXPECT_EQ(hold.resolve(true, kMoved, kTarget), kMoved);
+  EXPECT_EQ(hold.resolve(false, kMoved, kTarget), kTarget);
+  EXPECT_EQ(hold.resolve(false, kMoved, kInitial), kTarget);
+}
+
+TEST(SafetyPositionHold, RestCanRunWhileDisarmedAndItsEndpointRemainsHeld) {
+  PositionHold hold;
+  EXPECT_EQ(hold.resolve(false, {}, kMoved), kMoved);
+  // The controller treats a fresh explicit rest stream as a valid target
+  // independently of model arming. Losing that stream returns to HOLD.
+  EXPECT_EQ(hold.resolve(true, kInitial, kMoved), kInitial);
+  EXPECT_EQ(hold.resolve(true, kInitial, kInitial), kInitial);
+  EXPECT_EQ(hold.resolve(false, kInitial, kInitial), kInitial);
+  EXPECT_EQ(hold.resolve(false, {}, kMoved), kInitial);
+}
+
+TEST(SafetyPositionHold, ReactivationCapturesCurrentPoseInsteadOfPreviousHold) {
+  PositionHold hold;
+  EXPECT_EQ(hold.resolve(false, {}, kInitial), kInitial);
+  hold.reset();
+  EXPECT_EQ(hold.resolve(false, {}, kMoved), kMoved);
+  EXPECT_EQ(hold.resolve(false, {}, kInitial), kMoved);
+}
+
+TEST(SafetyPositionHold, ResumedCommandStillUsesPositionSlewLimit) {
+  PositionHold hold;
+  const auto held = hold.resolve(false, {}, kInitial);
+  const auto requested = hold.resolve(true, kTarget, kMoved);
+  const auto limited = franka_arm_controllers::safety_command::limit_position_slew(
+      requested, held, 0.001, 0.35, 0.001);
+  for (std::size_t joint = 0; joint < held.size(); ++joint) {
+    EXPECT_NEAR(limited[joint], held[joint] + (requested[joint] > held[joint] ? 0.00035 : -0.00035),
+                1e-12);
+  }
+}
+
+}  // namespace
