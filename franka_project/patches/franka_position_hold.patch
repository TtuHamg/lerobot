+#pragma once
+
+#include <franka_arm_controllers/safety_command_limits.hpp>
+
+namespace franka_arm_controllers::safety_command {
+
+// Capture the measured pose once when a model/rest stream stops. Refreshing
+// this pose every cycle would eliminate the impedance controller's restoring
+// torque and allow the arm to drift while waiting for the next command.
+class PositionHold {
+ public:
+  JointArray resolve(bool has_fresh_target,
+                     const JointArray& requested,
+                     const JointArray& measured) noexcept {
+    if (has_fresh_target) {
+      holding_ = false;
+      return requested;
+    }
+    if (!holding_) {
+      position_ = measured;
+      holding_ = true;
+    }
+    return position_;
+  }
+
+  void reset() noexcept { holding_ = false; }
+
+ private:
+  bool holding_{false};
+  JointArray position_{};
+};
+
+}  // namespace franka_arm_controllers::safety_command
