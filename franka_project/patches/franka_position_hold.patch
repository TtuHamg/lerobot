+    }
+    // Startup, disarm, expired input, and completed rest all latch the measured
+    // pose once. New valid model/rest input releases HOLD through the existing
+    // source arbitration and position/torque slew limits.
+    const auto target = safety_position_hold_.resolve(has_fresh_target, requested, measured);
+    joint_positions_desired_.assign(target.begin(), target.end());
+  }
